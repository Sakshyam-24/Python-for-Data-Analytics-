    "---\n",
    "## 9. Pivot Table Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "pivot = pd.pivot_table(\n",
    "    df, values='TotalAmount', index='City', columns='Category',\n",
    "    aggfunc='sum', fill_value=0\n",
    ").round(0)\n",
    "pivot['Total'] = pivot.sum(axis=1)\n",
    "pivot = pivot.sort_values('Total', ascending=False)\n",
    "\n",
    "print('Revenue Pivot Table: City x Category (NPR)')\n",
    "print('=' * 80)\n",
    "pivot"
   ]
